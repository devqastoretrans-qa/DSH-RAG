# Google Drive Integration Configuration
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
DRIVE_POLL_INTERVAL_SECONDS=60
# Set to 'false' for multi-worker web processes; set to 'true' in standalone drive worker
ENABLE_DRIVE_MONITOR=false

# Ingestion Pipeline Configuration
MAX_INGESTION_RETRIES=3

# Chunking Configuration
CHUNK_SIZE=150
CHUNK_OVERLAP=25

# Local Embedding Model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Qdrant Vector Database Configuration
# In production, a dedicated networked Qdrant instance is REQUIRED:
# - Docker Compose: http://qdrant:6333
# - Local Docker: http://localhost:6333
# - Qdrant Cloud: https://xxxxxx.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents
QDRANT_TIMEOUT=10.0

# OpenAI Configuration for RAG Generation (Optional - NOT required for document ingestion)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# MySQL Relational Database Configuration (Personalized RAG)
# If left empty, system automatically uses zero-config local SQLite fallback (users_data.db)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=rag_users

# REST API Security & CORS
RAG_API_KEY=dsh_rag_secret_key_2026
# In production, restrict to comma-separated trusted origins (e.g. https://doctorsarahhensley.com,https://dshstaging.doctorsarahhensley.com)
ALLOWED_ORIGINS=https://doctorsarahhensley.com,https://www.doctorsarahhensley.com,https://dshstaging.doctorsarahhensley.com

# WordPress WooCommerce Customer & Order Database API
WORDPRESS_URL=https://dshstaging.doctorsarahhensley.com
WORDPRESS_USER=admin@tribus.pub
WORDPRESS_APP_PASSWORD=your_wordpress_application_password
# Set to 'true' in production to enforce TLS/SSL certificate verification; 'false' strictly for self-signed local dev
WP_SSL_VERIFY=true

# Logging Configuration & Disk Exhaustion Protection
# Default 10MB (10485760 bytes) per file, keeping 5 historical rotated archives (50MB cap per log file)
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5


